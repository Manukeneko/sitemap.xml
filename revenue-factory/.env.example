# データベース（開発時はSQLiteでOK。本番はSupabaseのPostgreSQL接続文字列に差し替え、
# prisma/schema.prisma の datasource provider も "postgresql" に変更する）
DATABASE_URL="file:./dev.db"

# Anthropic Claude API（必須。市場調査・スコアリング・企画AIで使用）
ANTHROPIC_API_KEY=""

# YouTube Data API v3（任意。未設定の場合、市場調査ソースとしてスキップされる）
YOUTUBE_API_KEY=""

# 楽天ウェブサービスAPI（任意、Phase4で使用予定）
RAKUTEN_APP_ID=""

# ダッシュボード簡易認証（Phase1、任意）
DASHBOARD_BASIC_AUTH_USER=""
DASHBOARD_BASIC_AUTH_PASSWORD=""

# ROI計算用のドル円レート概算（任意、未設定なら150を使用。Phase7 §14）
USD_JPY_RATE="150"

# OpenAI API（任意、Phase3。設定するとサムネイル画像生成(gpt-image-1)とナレーション音声生成(tts-1)が使えます）
OPENAI_API_KEY=""
# 画像1枚あたりの概算コスト(USD、任意、未設定なら0.04)
IMAGE_COST_USD="0.04"
# 音声1000文字あたりの概算コスト(USD、任意、未設定なら0.015)
TTS_COST_PER_1K_CHARS_USD="0.015"
