# データベース（PostgreSQL必須。Vercel等サーバーレス環境はファイルシステムが
# 永続化されないためSQLiteは使えない。Supabase等でプロジェクトを作成し、
# 発行される接続文字列[Transaction pooler推奨]を設定する）
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres"

# Anthropic Claude API（必須。市場調査・スコアリング・企画AIで使用）
ANTHROPIC_API_KEY=""

# YouTube Data API v3（任意。未設定の場合、市場調査ソースとしてスキップされる）
YOUTUBE_API_KEY=""

# 楽天ウェブサービスAPI（任意、Phase4）
# 2026年2〜5月に楽天ウェブサービスの新API基盤への移行が行われ、旧エンドポイントは
# 2026-05-14に完全停止した。新基盤ではアプリケーションIDに加えてアクセスキーが必須。
RAKUTEN_APP_ID=""
# 「アクセスキー」（楽天ウェブサービス管理画面に表示。Authorization: Bearerヘッダーで送信）
RAKUTEN_ACCESS_KEY=""
# 楽天アフィリエイトID（任意。設定すると検索結果のURLに反映され成果が計測される）
RAKUTEN_AFFILIATE_ID=""
# アプリ登録時に設定した「許可されたWebサイト」と同じURL（Referer/Originヘッダーとして送信必須。
# 一致しないと HTTP_REFERRER_MISSING エラーになる）
RAKUTEN_REFERER_URL=""
# 新APIのエンドポイントURL（任意。既定値が変わっていた場合の保険として上書き可能）
RAKUTEN_API_BASE_URL=""

# Amazon PA-API 5.0（任意、Phase4。Amazonアソシエイトの利用条件[実績]を満たすアカウントが必要）
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TAG=""
# 既定は日本のマーケットプレイス。他国で使う場合は変更する
AMAZON_HOST="webservices.amazon.co.jp"
AMAZON_REGION="us-west-2"
AMAZON_MARKETPLACE="www.amazon.co.jp"

# ダッシュボード簡易認証（Phase1、任意）
DASHBOARD_BASIC_AUTH_USER=""
DASHBOARD_BASIC_AUTH_PASSWORD=""

# ROI計算用のドル円レート概算（任意、未設定なら150を使用。Phase7 §14）
USD_JPY_RATE="150"

# OpenAI API（任意、Phase3。設定するとサムネイル画像生成(gpt-image-1)とナレーション音声生成(tts-1)が使えます）
OPENAI_API_KEY=""
# 画像1枚あたりの概算コスト(USD、任意、未設定なら0.04)
IMAGE_COST_USD="0.04"
# 音声1000文字あたりの概算コスト(USD、任意、未設定なら0.015)
TTS_COST_PER_1K_CHARS_USD="0.015"

# X (Twitter) API v2（任意、Phase5〜9。設定するとx_post/x_threadの実投稿ができます）
# X Developer Portalで自分のアカウント用のAccess Token/Secretを発行して設定する
# （このシステムは単一運用者を想定しているため3-legged OAuthフローは実装していない）
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
